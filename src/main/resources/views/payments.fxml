<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" stylesheets="@../styles/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotevia.controller.PaymentController">
    <!-- Header -->
    <VBox spacing="4">
        <Label styleClass="title-header" text="Billing &amp; Payment Management" />
        <Label styleClass="subtitle" text="Record customer payments, track outstanding balances, support multiple payment methods, and generate receipts" />
    </VBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Payments Ledger Table Card -->
        <VBox spacing="14" styleClass="content-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label styleClass="section-title" text="Recent Payment Transactions Ledger" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handlePrintPaymentReceipt" styleClass="btn-primary" text="📄  Print Receipt" />
            </HBox>

            <TableView fx:id="paymentTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPayId" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colResCode" prefWidth="110" text="Booking #" />
                    <TableColumn fx:id="colCustomer" prefWidth="140" text="Guest Name" />
                    <TableColumn fx:id="colAmount" prefWidth="95" text="Amount ($)" />
                    <TableColumn fx:id="colMethod" prefWidth="110" text="Method" />
                    <TableColumn fx:id="colDate" prefWidth="140" text="Transaction Date" />
                    <TableColumn fx:id="colNotes" prefWidth="160" text="Notes" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Process Payment Card -->
        <VBox prefWidth="330" spacing="14" styleClass="content-card">
            <Label styleClass="section-title" text="Record New Payment" />

            <VBox spacing="5">
                <Label styleClass="form-label" text="SELECT RESERVATION" />
                <ComboBox fx:id="cmbReservation" maxWidth="Infinity" />
            </VBox>

            <!-- Bill Balance Breakdown -->
            <VBox spacing="6" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8px; -fx-padding: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 8px;">
                <HBox alignment="CENTER_LEFT">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px;" text="Total Bill Amount:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblTotalDue" style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" text="$0.00" />
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px;" text="Already Paid:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblAlreadyPaid" style="-fx-font-weight: bold; -fx-text-fill: #10B981;" text="$0.00" />
                </HBox>
                <HBox alignment="CENTER_LEFT" style="-fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0; -fx-padding: 4 0 0 0;">
                    <Label style="-fx-text-fill: #EF4444; -fx-font-weight: bold;" text="Outstanding Balance:" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblBalance" style="-fx-font-size: 15px; -fx-font-weight: 800; -fx-text-fill: #EF4444;" text="$0.00" />
                </HBox>
            </VBox>

            <VBox spacing="5">
                <Label styleClass="form-label" text="PAYMENT AMOUNT ($)" />
                <TextField fx:id="txtAmount" promptText="0.00" />
            </VBox>

            <VBox spacing="5">
                <Label styleClass="form-label" text="PAYMENT METHOD" />
                <ComboBox fx:id="cmbMethod" maxWidth="Infinity" />
            </VBox>

            <VBox spacing="5">
                <Label styleClass="form-label" text="PAYMENT REFERENCE / NOTE" />
                <TextField fx:id="txtNotes" promptText="Card ending in 4321, cash desk..." />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" onAction="#handleProcessPayment" prefHeight="42" styleClass="btn-gold" text="💳  PROCESS TRANSACTION" />
        </VBox>
    </HBox>
</VBox>
