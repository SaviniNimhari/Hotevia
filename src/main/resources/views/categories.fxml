<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" stylesheets="@../styles/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotevia.controller.CategoryController">
    <!-- Header -->
    <VBox spacing="4">
        <Label styleClass="title-header" text="Room Categories &amp; Pricing" />
        <Label styleClass="subtitle" text="Define room tiers, base rates per night, descriptions, and maximum guest capacities" />
    </VBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Categories Table Card -->
        <VBox spacing="14" styleClass="content-card" HBox.hgrow="ALWAYS">
            <TableView fx:id="categoryTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colName" prefWidth="160" text="Category Name" />
                    <TableColumn fx:id="colPrice" prefWidth="110" text="Price/Night ($)" />
                    <TableColumn fx:id="colCapacity" prefWidth="90" text="Capacity (Guests)" />
                    <TableColumn fx:id="colDescription" prefWidth="250" text="Description" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Category Form Card -->
        <VBox prefWidth="320" spacing="14" styleClass="content-card">
            <Label styleClass="section-title" text="Category Configuration" />

            <VBox spacing="6">
                <Label styleClass="form-label" text="CATEGORY NAME" />
                <TextField fx:id="txtName" promptText="e.g. Deluxe Suite" />
            </VBox>

            <VBox spacing="6">
                <Label styleClass="form-label" text="PRICE PER NIGHT ($)" />
                <TextField fx:id="txtPrice" promptText="e.g. 250.00" />
            </VBox>

            <VBox spacing="6">
                <Label styleClass="form-label" text="MAX GUEST CAPACITY" />
                <TextField fx:id="txtCapacity" promptText="e.g. 2, 4" />
            </VBox>

            <VBox spacing="6">
                <Label styleClass="form-label" text="DESCRIPTION / AMENITIES" />
                <TextArea fx:id="txtDescription" prefRowCount="4" promptText="Room features, view, bed size..." wrapText="true" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Action Buttons -->
            <VBox spacing="8">
                <Button maxWidth="Infinity" onAction="#handleSave" styleClass="btn-gold" text="💾  Save / Update Category" />
                <HBox spacing="8">
                    <Button maxWidth="Infinity" onAction="#handleClear" styleClass="btn-secondary" text="Clear Form" HBox.hgrow="ALWAYS" />
                    <Button maxWidth="Infinity" onAction="#handleDelete" styleClass="btn-danger" text="Delete" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
