<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" stylesheets="@../styles/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotevia.controller.CustomerController">
    <!-- Header -->
    <VBox spacing="4">
        <Label styleClass="title-header" text="Customer &amp; Guest Profiles" />
        <Label styleClass="subtitle" text="Register guests, update contact and identification records, and track historical stays" />
    </VBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Customers Table Card -->
        <VBox spacing="14" styleClass="content-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <TextField fx:id="txtSearch" onKeyReleased="#handleSearch" prefWidth="300" promptText="🔍 Search name, phone, email, or passport..." />
                <Button onAction="#handleSearch" styleClass="btn-secondary" text="Search" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <TableView fx:id="customerTable" prefHeight="260" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colName" prefWidth="150" text="Guest Name" />
                    <TableColumn fx:id="colPhone" prefWidth="120" text="Phone" />
                    <TableColumn fx:id="colEmail" prefWidth="160" text="Email" />
                    <TableColumn fx:id="colPassport" prefWidth="110" text="ID / Passport" />
                    <TableColumn fx:id="colAddress" prefWidth="180" text="Address" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <!-- Reservation History for Selected Guest -->
            <VBox spacing="6">
                <Label styleClass="section-title" text="Guest Reservation History" />
                <TableView fx:id="historyTable" prefHeight="130">
                    <columns>
                        <TableColumn fx:id="colHistCode" prefWidth="130" text="Reservation #" />
                        <TableColumn fx:id="colHistRoom" prefWidth="90" text="Room" />
                        <TableColumn fx:id="colHistDates" prefWidth="180" text="Stay Duration" />
                        <TableColumn fx:id="colHistStatus" prefWidth="110" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>

        <!-- Customer Form Card -->
        <VBox prefWidth="320" spacing="12" styleClass="content-card">
            <Label styleClass="section-title" text="Customer Details" />

            <VBox spacing="5">
                <Label styleClass="form-label" text="FULL NAME" />
                <TextField fx:id="txtName" promptText="e.g. Eleanor Vance" />
            </VBox>

            <VBox spacing="5">
                <Label styleClass="form-label" text="PHONE NUMBER" />
                <TextField fx:id="txtPhone" promptText="+1 (555) 012-3456" />
            </VBox>

            <VBox spacing="5">
                <Label styleClass="form-label" text="EMAIL ADDRESS" />
                <TextField fx:id="txtEmail" promptText="guest@example.com" />
            </VBox>

            <VBox spacing="5">
                <Label styleClass="form-label" text="ID CARD / PASSPORT NO" />
                <TextField fx:id="txtPassport" promptText="e.g. US-P9876543" />
            </VBox>

            <VBox spacing="5">
                <Label styleClass="form-label" text="BILLING / HOME ADDRESS" />
                <TextArea fx:id="txtAddress" prefRowCount="3" promptText="Street address, city, state..." wrapText="true" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Action Buttons -->
            <VBox spacing="8">
                <Button maxWidth="Infinity" onAction="#handleSave" styleClass="btn-gold" text="💾  Save / Update Guest" />
                <HBox spacing="8">
                    <Button maxWidth="Infinity" onAction="#handleClear" styleClass="btn-secondary" text="Clear Form" HBox.hgrow="ALWAYS" />
                    <Button maxWidth="Infinity" onAction="#handleDelete" styleClass="btn-danger" text="Delete" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
