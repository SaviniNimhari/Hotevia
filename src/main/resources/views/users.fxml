<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" stylesheets="@../styles/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotevia.controller.UserController">
    <!-- Header -->
    <VBox spacing="4">
        <Label styleClass="title-header" text="Staff &amp; Access Control" />
        <Label styleClass="subtitle" text="Manage hotel personnel accounts, role-based privileges (Admin / Receptionist), and status" />
    </VBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Users Table Card -->
        <VBox spacing="14" styleClass="content-card" HBox.hgrow="ALWAYS">
            <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colUserId" prefWidth="50" text="ID" />
                    <TableColumn fx:id="colUsername" prefWidth="120" text="Username" />
                    <TableColumn fx:id="colFullName" prefWidth="170" text="Staff Name" />
                    <TableColumn fx:id="colRole" prefWidth="120" text="System Role" />
                    <TableColumn fx:id="colStatus" prefWidth="90" text="Status" />
                    <TableColumn fx:id="colCreatedAt" prefWidth="140" text="Created Date" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- User Form Card -->
        <VBox prefWidth="320" spacing="12" styleClass="content-card">
            <Label styleClass="section-title" text="Account Details" />

            <VBox spacing="5">
                <Label styleClass="form-label" text="USERNAME" />
                <TextField fx:id="txtUsername" promptText="e.g. receptionist2" />
            </VBox>

            <VBox spacing="5">
                <Label styleClass="form-label" text="FULL NAME" />
                <TextField fx:id="txtFullName" promptText="e.g. Sarah Jenkins" />
            </VBox>

            <VBox spacing="5">
                <Label styleClass="form-label" text="PASSWORD" />
                <PasswordField fx:id="txtPassword" promptText="Enter password (leave blank to keep)" />
            </VBox>

            <VBox spacing="5">
                <Label styleClass="form-label" text="ASSIGNED ROLE" />
                <ComboBox fx:id="cmbRole" maxWidth="Infinity" />
            </VBox>

            <VBox spacing="5">
                <Label styleClass="form-label" text="ACCOUNT STATUS" />
                <ComboBox fx:id="cmbStatus" maxWidth="Infinity" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Action Buttons -->
            <VBox spacing="8">
                <Button maxWidth="Infinity" onAction="#handleSave" styleClass="btn-gold" text="💾  Save / Update User" />
                <HBox spacing="8">
                    <Button maxWidth="Infinity" onAction="#handleClear" styleClass="btn-secondary" text="Clear Form" HBox.hgrow="ALWAYS" />
                    <Button maxWidth="Infinity" onAction="#handleDelete" styleClass="btn-danger" text="Delete" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
