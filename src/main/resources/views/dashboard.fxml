<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" stylesheets="@../styles/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotevia.controller.DashboardController">
    <VBox spacing="20">
        <padding><Insets bottom="20" left="5" right="10" top="5" /></padding>

        <!-- Page Header -->
        <VBox spacing="4">
            <Label styleClass="title-header" text="Executive Dashboard" />
            <Label styleClass="subtitle" text="Real-time hotel occupancy, daily turnover, and revenue indicators" />
        </VBox>

        <!-- KPI STATS CARDS -->
        <GridPane hgap="15" vgap="15">
            <!-- Total Rooms -->
            <VBox prefWidth="180" styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label styleClass="stat-label" text="TOTAL ROOMS" />
                <Label fx:id="lblTotalRooms" styleClass="stat-value" text="0" />
            </VBox>

            <!-- Available Rooms -->
            <VBox prefWidth="180" styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label styleClass="stat-label" text="AVAILABLE ROOMS" />
                <Label fx:id="lblAvailableRooms" style="-fx-text-fill: #10B981;" styleClass="stat-value" text="0" />
            </VBox>

            <!-- Occupied Rooms -->
            <VBox prefWidth="180" styleClass="stat-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label styleClass="stat-label" text="OCCUPIED ROOMS" />
                <Label fx:id="lblOccupiedRooms" style="-fx-text-fill: #EF4444;" styleClass="stat-value" text="0" />
            </VBox>

            <!-- Total Reservations -->
            <VBox prefWidth="180" styleClass="stat-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                <Label styleClass="stat-label" text="TOTAL RESERVATIONS" />
                <Label fx:id="lblTotalReservations" styleClass="stat-value" text="0" />
            </VBox>

            <!-- Today's Check-ins -->
            <VBox prefWidth="180" styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label styleClass="stat-label" text="TODAY'S CHECK-INS" />
                <Label fx:id="lblTodayCheckIns" styleClass="stat-value" text="0" />
            </VBox>

            <!-- Today's Check-outs -->
            <VBox prefWidth="180" styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label styleClass="stat-label" text="TODAY'S CHECK-OUTS" />
                <Label fx:id="lblTodayCheckOuts" styleClass="stat-value" text="0" />
            </VBox>

            <!-- Total Revenue -->
            <VBox prefWidth="380" styleClass="stat-card, stat-card-gold" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="1">
                <Label style="-fx-text-fill: #D4AF37; -fx-font-weight: bold; -fx-font-size: 12px;" text="GROSS COLLECTED REVENUE" />
                <Label fx:id="lblTotalRevenue" style="-fx-text-fill: #0F172A; -fx-font-size: 26px; -fx-font-weight: 800;" text="0.00" />
            </VBox>
        </GridPane>

        <!-- CHART AND RECENT BOOKINGS SPLIT -->
        <HBox spacing="20">
            <!-- Pie Chart Card -->
            <VBox prefWidth="420" spacing="12" styleClass="content-card">
                <Label styleClass="section-title" text="Room Status Distribution" />
                <PieChart fx:id="occupancyPieChart" legendVisible="true" prefHeight="280" />
            </VBox>

            <!-- Recent Bookings Table Card -->
            <VBox spacing="12" styleClass="content-card" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="Latest Reservations" />
                <TableView fx:id="recentReservationsTable" prefHeight="280">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="110" text="Code" />
                        <TableColumn fx:id="colCustomer" prefWidth="130" text="Guest Name" />
                        <TableColumn fx:id="colRoom" prefWidth="65" text="Room" />
                        <TableColumn fx:id="colCheckIn" prefWidth="95" text="Check-in" />
                        <TableColumn fx:id="colCheckOut" prefWidth="95" text="Check-out" />
                        <TableColumn fx:id="colTotal" prefWidth="85" text="Total ($)" />
                        <TableColumn fx:id="colStatus" prefWidth="95" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
